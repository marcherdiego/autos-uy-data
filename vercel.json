{
  "buildCommand": "",
  "outputDirectory": "public",
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" = \"corridas\" ] || git diff --quiet HEAD^ HEAD -- public api vercel.json package.json requirements.txt tools/scrape_catalog.py",
  "regions": [
    "gru1"
  ],
  "functions": {
    "api/cron/catalogo.py": {
      "includeFiles": "tools/scrape_catalog.py",
      "maxDuration": 60
    },
    "api/cron/vigia.js": {
      "maxDuration": 60
    },
    "api/share.js": {
      "maxDuration": 15
    }
  },
  "crons": [
    {
      "path": "/api/cron/catalogo",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/vigia",
      "schedule": "0 13 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/auto/:a",
      "destination": "/api/share?t=auto&a=:a"
    },
    {
      "source": "/marca/:a",
      "destination": "/api/share?t=marca&a=:a"
    },
    {
      "source": "/comparar/:a/:b",
      "destination": "/api/share?t=comparar&a=:a&b=:b"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
